---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Payment failed | Newlands Cottages"
  description="Your Newlands Cottages payment did not complete."
>
  <section class="bg-[#f7f4ef] py-16 sm:py-24">
    <div class="mx-auto max-w-2xl px-6">
      <h1 class="text-3xl font-semibold tracking-normal text-gray-900 sm:text-4xl">Payment failed</h1>
      <p class="mt-5 text-lg leading-8 text-gray-700">
        The payment did not complete. Please use your Beds24 payment link to try again, or contact Newlands Cottages if the problem continues.
      </p>
    </div>
  </section>
</BaseLayout>
