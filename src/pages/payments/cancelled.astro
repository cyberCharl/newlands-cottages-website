---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Payment cancelled | Newlands Cottages"
  description="Your Newlands Cottages payment was cancelled."
>
  <section class="bg-[#f7f4ef] py-16 sm:py-24">
    <div class="mx-auto max-w-2xl px-6">
      <h1 class="text-3xl font-semibold tracking-normal text-gray-900 sm:text-4xl">Payment cancelled</h1>
      <p class="mt-5 text-lg leading-8 text-gray-700">
        No payment has been recorded. You can return to your Beds24 payment link when you are ready to try again.
      </p>
    </div>
  </section>
</BaseLayout>
