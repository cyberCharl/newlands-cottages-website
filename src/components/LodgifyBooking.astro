---
import { joinWithBase } from '../utils/url';

const contactUrl = joinWithBase(import.meta.env.BASE_URL, '/contact-us');
---

<section
  id="book-your-stay"
  class="scroll-mt-28 max-w-6xl mx-auto px-4 pb-8 sm:pb-12"
  aria-labelledby="booking-heading"
>
  <div
    class="lodgify-booking-card relative isolate overflow-hidden rounded-[1.75rem] border border-emerald-900/10 bg-[#f4f1e8] px-4 py-6 shadow-[0_24px_70px_rgba(0,39,30,0.12)] sm:px-8 sm:py-9 lg:px-10 lg:py-10"
  >
    <div class="relative z-10 mb-5 sm:mb-7 lg:flex lg:items-end lg:justify-between lg:gap-8">
      <div class="max-w-2xl">
        <h2 id="booking-heading" class="text-2xl font-semibold text-emerald-950 sm:text-3xl">
          Find your dates at Clarkia Cottage
        </h2>
      </div>
    </div>

    <div
      class="lodgify-widget-shell relative z-10 rounded-2xl border border-white/80 bg-white/85 p-2 shadow-sm sm:p-3"
    >
      <div
        id="lodgify-book-now-box"
        data-rental-id="831630"
        data-website-id="668924"
        data-slug="susanne-botha"
        data-language-code="en"
        data-new-tab="false"
        data-version="stable"
        data-has-guests-breakdown
        data-check-in-label="Check-in"
        data-check-out-label="Check-out"
        data-guests-label="Guests"
        data-guests-singular-label="{{NumberOfGuests}} guest"
        data-guests-plural-label="{{NumberOfGuests}} guests"
        data-location-input-label="Location"
        data-total-price-label="Total price:"
        data-select-dates-to-see-price-label="Select dates to see total price"
        data-minimum-price-per-night-first-label="From"
        data-minimum-price-per-night-second-label="per night"
        data-book-button-label="Book Now"
        data-guests-breakdown-label="Guests"
        data-adults-label='{"one":"adult","other":"adults"}'
        data-adults-description="Ages {minAge} or above"
        data-children-label='{"one":"child","other":"children"}'
        data-children-description="Ages {minAge}-{maxAge}"
        data-children-not-allowed-label="Not suitable for children"
        data-infants-label='{"one":"infant","other":"infants"}'
        data-infants-description="Under {maxAge}"
        data-infants-not-allowed-label="Not suitable for infants"
        data-pets-label='{"one":"pet","other":"pets"}'
        data-pets-not-allowed-label="Not allowed"
        data-done-label="Done"
      >
      </div>

      <noscript>
        <p class="p-4 text-center text-sm text-stone-700">
          Online booking requires JavaScript. Please
          <a class="font-semibold text-emerald-900 underline" href={contactUrl}>contact us</a>
          to make a reservation.
        </p>
      </noscript>
    </div>
  </div>
</section>

<script is:inline src="https://app.lodgify.com/book-now-box/stable/renderBookNowBox.js" defer
></script>

<style is:global>
  #book-your-stay {
    --ldg-bnb-background: #ffffff;
    --ldg-bnb-border-radius: 0.875rem;
    --ldg-bnb-box-shadow: none;
    --ldg-bnb-padding: 14px;
    --ldg-bnb-input-background: #fbfaf6;
    --ldg-bnb-button-border-radius: 999px;
    --ldg-bnb-color-primary: #004e3b;
    --ldg-bnb-color-primary-lighter: #80a79d;
    --ldg-bnb-color-primary-darker: #00271e;
    --ldg-bnb-color-primary-contrast: #feffff;
    --ldg-component-calendar-cell-selection-bg-color: #004e3b;
    --ldg-component-calendar-cell-selection-color: #feffff;
    --ldg-component-calendar-cell-selected-bg-color: #80a79d;
    --ldg-component-calendar-cell-selected-color: #feffff;
    --ldg-bnb-font-family: inherit;
  }

  .lodgify-booking-card::before {
    position: absolute;
    top: -7rem;
    right: -5rem;
    z-index: -1;
    width: 23rem;
    height: 23rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgb(128 167 157 / 20%) 0%, rgb(128 167 157 / 0%) 68%);
    content: '';
    pointer-events: none;
  }

  .lodgify-booking-card::after {
    position: absolute;
    right: 2rem;
    bottom: -5.5rem;
    z-index: -1;
    width: 16rem;
    height: 10rem;
    border: 1px solid rgb(0 78 59 / 9%);
    border-radius: 50%;
    content: '';
    pointer-events: none;
    transform: rotate(-12deg);
  }

  .booking-benefits li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .booking-benefits span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #80a79d;
    box-shadow: 0 0 0 4px rgb(128 167 157 / 14%);
  }

  .lodgify-widget-shell {
    backdrop-filter: blur(8px);
  }

  #lodgify-book-now-box {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 7.5rem;
  }

  #lodgify-book-now-box [data-testid='book-now-box.date-picker.trigger'],
  #lodgify-book-now-box [data-testid='guests-breakdown-trigger'] {
    border-color: rgb(0 78 59 / 16%) !important;
    background: #fbfaf6 !important;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 80%) !important;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease !important;
  }

  #lodgify-book-now-box [data-testid='book-now-box.date-picker.trigger']:hover,
  #lodgify-book-now-box [data-testid='guests-breakdown-trigger']:hover {
    border-color: rgb(0 78 59 / 42%) !important;
    background: #ffffff !important;
    box-shadow: 0 6px 18px rgb(0 39 30 / 8%) !important;
  }

  #lodgify-book-now-box [data-testid='book-now-box.date-picker.trigger']:focus-visible,
  #lodgify-book-now-box [data-testid='guests-breakdown-trigger']:focus-visible,
  #lodgify-book-now-box [data-testid='book-now-box.cta-button']:focus-visible {
    outline: 3px solid rgb(128 167 157 / 45%) !important;
    outline-offset: 3px !important;
  }

  #lodgify-book-now-box [data-testid='book-now-box.cta-button'] {
    box-shadow: 0 8px 22px rgb(0 78 59 / 20%) !important;
    font-weight: 700 !important;
    letter-spacing: 0.01em !important;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease !important;
  }

  #lodgify-book-now-box [data-testid='book-now-box.cta-button']:hover {
    box-shadow: 0 12px 28px rgb(0 78 59 / 28%) !important;
    transform: translateY(-1px);
  }

  @media (min-width: 1024px) {
    .lodgify-widget-shell {
      padding: 0.75rem;
      border-color: rgb(0 78 59 / 8%);
      box-shadow:
        0 18px 45px rgb(0 39 30 / 8%),
        inset 0 1px 0 rgb(255 255 255 / 90%);
    }

    #lodgify-book-now-box [data-testid='book-now-box'] {
      display: grid !important;
      grid-template-columns:
        minmax(14rem, 1.3fr) minmax(9rem, 0.75fr) minmax(11.5rem, 0.85fr)
        minmax(9rem, 0.75fr) !important;
      grid-template-rows: 1fr 1fr !important;
      gap: 0.2rem 0.75rem !important;
      align-items: center !important;
      width: 100% !important;
      min-width: 0 !important;
      padding: 0.75rem !important;
    }

    #lodgify-book-now-box [data-testid='book-now-box.date-picker.trigger'] {
      grid-column: 1;
      grid-row: 1 / 3;
      width: 100% !important;
      height: 4.25rem !important;
      padding-inline: 1rem !important;
    }

    #lodgify-book-now-box [data-testid='guests-breakdown-trigger'] {
      grid-column: 2;
      grid-row: 1 / 3;
      width: 100% !important;
      height: 4.25rem !important;
      padding-inline: 1rem !important;
    }

    #lodgify-book-now-box [data-testid='book-now-box.cta-button'] {
      grid-column: 4;
      grid-row: 1 / 3;
      width: 100% !important;
      height: 4.25rem !important;
    }

    #lodgify-book-now-box [data-testid='book-now-box'] > div:nth-child(4) {
      grid-column: 3;
      grid-row: 1;
      align-self: end;
      width: 100% !important;
    }

    #lodgify-book-now-box [data-testid='book-now-box'] > div:nth-child(5) {
      grid-column: 3;
      grid-row: 2;
      align-self: start;
      width: 100% !important;
    }

    #lodgify-book-now-box [data-testid='book-now-box.minimum-price-per-night.text'] {
      color: #57534e !important;
      font-size: 0.8rem !important;
      line-height: 1.25rem !important;
    }

    #lodgify-book-now-box [data-testid='text'] {
      color: #004e3b !important;
      font-size: 0.875rem !important;
      font-weight: 700 !important;
      line-height: 1.15rem !important;
    }
  }

  @media (max-width: 640px) {
    #lodgify-book-now-box {
      min-height: 18rem;
    }

    .lodgify-booking-card {
      border-radius: 1.25rem;
    }
  }
</style>
