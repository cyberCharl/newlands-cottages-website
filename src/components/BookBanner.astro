<div
  id="book-banner"
  class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 shadow-lg flex items-center px-4 py-3"
>
  <div class="flex-1">
    <a href="#book-your-stay" class="btn block w-full text-center text-base">
      Check Availability & Book Now
    </a>
  </div>
  <div class="flex-none">
    <button
      type="button"
      id="dismiss-book-banner"
      class="inline-flex justify-center w-7 h-7 items-center text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 dark:hover:bg-gray-600 dark:hover:text-white"
      aria-label="Close booking banner"
    >
      <svg
        class="w-3 h-3"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 14"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const banner = document.getElementById('book-banner');
    const bookingSection = document.getElementById('book-your-stay');
    const dismissButton = document.getElementById('dismiss-book-banner');

    if (!banner || !bookingSection || !dismissButton) return;

    let dismissed = false;

    dismissButton.addEventListener('click', () => {
      dismissed = true;
      banner.style.display = 'none';
    });

    function handleIntersect(entries: IntersectionObserverEntry[]) {
      entries.forEach((entry: IntersectionObserverEntry) => {
        if (!banner) return;
        banner.style.display = dismissed || entry.isIntersecting ? 'none' : 'flex';
      });
    }

    const observer = new window.IntersectionObserver(handleIntersect, {
      root: null,
      threshold: 0.1,
    });

    observer.observe(bookingSection);
    window.addEventListener('beforeunload', () => observer.disconnect());
  });
</script>
